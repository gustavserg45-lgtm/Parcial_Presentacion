# Proyecto Compose
COMPOSE_PROJECT_NAME=sanluquitas

# Portal Laravel
APP_NAME="San Luquitas Digital"
APP_ENV=local
APP_DEBUG=false
APP_KEY=GENERATE_WITH_scripts/init-env.sh
APP_URL=http://localhost:8083
PORTAL_HTTP_PORT=8083
NEWS_ADMIN_TOKEN=GENERATE_WITH_scripts/init-env.sh
MOODLE_ADMIN_PASSWORD=GENERATE_WITH_scripts/init-env.sh
MOODLE_ADMIN_EMAIL=admin@sanluquitas.local
MOODLE_TEST_USER_PASSWORD=GENERATE_WITH_scripts/init-env.sh
MOODLE_SITE_FULLNAME="San Luquitas Digital"
MOODLE_SITE_SHORTNAME="San Luquitas"

PORTAL_DB_NAME=portal
PORTAL_DB_USER=portal_app
PORTAL_DB_PASSWORD=GENERATE_WITH_scripts/init-env.sh
PORTAL_DB_ROOT_PASSWORD=GENERATE_WITH_scripts/init-env.sh

# Moodle 5.2 sobre PHP 8.3. La URL se resuelve en bootstrap-moodle.sh.
MOODLE_HTTP_PORT=8084
MOODLE_WWWROOT=http://localhost:8084
MOODLE_PHP_IMAGE_TAG=8.3
MOODLE_DOWNLOAD_URL=https://download.moodle.org/download.php/direct/stable502/moodle-latest-502.zip
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_app
MOODLE_DB_PASSWORD=GENERATE_WITH_scripts/init-env.sh
MARIADB_ROOT_PASSWORD=GENERATE_WITH_scripts/init-env.sh

